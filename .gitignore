config.json

# ==========================================
# IDEs & Editores
# ==========================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / CLion / RustRover
.idea/
*.iml

# Visual Studio / Windows
*.user
*.userosv
*.suo
*.sln.docstates

# ==========================================
# Arquivos de Cache e Log
# ==========================================
*.log
*.tmp
*.bak

# ==========================================
# Android (Arquivos gerados por build/bundle)
# ==========================================
*.apk
*.aab
*.dex
.gradle/
build/
local.properties

